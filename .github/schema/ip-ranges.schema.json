{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/truefoundry/ip-ranges/main/.github/schema/ip-ranges.schema.json",
  "title": "TrueFoundry IP ranges",
  "description": "Outbound NAT addresses for one control plane. The directory (eu or us) is the control plane.",
  "type": "object",
  "required": ["endpoints"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "endpoints": {
      "type": "array",
      "items": { "$ref": "#/$defs/endpoint" }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": ["type", "hostname", "nat_ips"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["control_plane", "gateway"]
        },
        "airport_code": {
          "type": "string",
          "pattern": "^[a-z]{3}$",
          "description": "IATA code for one gateway airport. Absent on geolocated hostnames such as us.gateway.truefoundry.ai."
        },
        "hostname": {
          "type": "string",
          "format": "hostname",
          "description": "The hostname a customer connects to. nat_ips is the full allowlist for this hostname."
        },
        "nat_ips": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])/(3[0-2]|[12]?[0-9])$",
            "description": "IPv4 CIDR. Single addresses are written as /32."
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "control_plane" } },
            "required": ["type"]
          },
          "then": {
            "not": { "required": ["airport_code"] }
          }
        }
      ]
    }
  }
}
